000A: 8093; -- WaitForStart: CALL IncrementRNG
000B: 9000; --                      In Switches
000C: 28B6; --                      Sub StartBit
000D: 780A; --                      JNZ WaitForStart ;wait until only switch 9 is up for game to begin
000E: 1802; --                      Loadi 2 ;
000F: 9874; --                      Out MasCmd ; resets master + sub-channel counts
0010: 192C; --                      Loadi 300
0011: 9871; --                      Out Sub1 ;Set Sub1 countdown to 3 seconds (10 ms tick * 300 = 3 seconds)
0012: 1803; --                      Loadi 3
0013: 9805; --                      Out Hex1 ;Show 3 on game clock
0014: 1801; --                      Loadi 1
0015: 9875; --                      Out SubCmd ;enables Sub1 to run, but waits for master
0016: 9874; --                      Out MasCmd ;Start master and Sub1 at the same time
0017: 9071; --                      In Sub1 
