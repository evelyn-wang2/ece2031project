0019: 9805; --                      Out Hex1 ;Display countdown in seconds on left-most hex
001A: 9076; --                      In Expiry
001B: 38B0; --                      And Sub1Done
001C: 781E; --                      Jnz CountDone ;Once countdown is finished, jump to 'CountDone'
001D: 5817; --                      Jump CountDown ;Otherwise repeat
001E: 1800; --                      Loadi 0
001F: 9875; --                      Out SubCmd ;put Sub1 in stop state 
0020: 9805; --                      Out Hex1 ;diplay 0 on game clock
0021: 1802; --                      Loadi 2
0022: 9874; --                      Out MasCmd ;resets master + sub-channel counts
0023: 5824; --                      Jump StartGame
0024: 08B7; --                      Load GameDuration ;Set Sub1 countdown to 30 seconds (10 ms tick * 3000 = 3 seconds)
0025: 9871; --                      Out Sub1
0026: 1801; --                      Loadi 1
0027: 9875; --                      Out SubCmd ;enables Sub1 to run, but waits for master
0028: 9874; --                      Out MasCmd ;Start master and Sub1 at the same time
0029: 5834; --                      Jump NewRound
002A: 9000; -- GameLoop: In Switches ; pause mechanism
002B: 38B6; --                      And StartBit
002C: 5019; --                      Shift -9 
002D: 9874; --                      Out MasCmd
002E: 9071; --                      In Sub1
002F: 8082; --                      Call ConvertSeconds
0030: 9805; --                      Out Hex1 ;Displays game clock on left most Hex digits
0031: 9076; --                      In Expiry
0032: 38B0; --                      And Sub1Done
0033: 7852; --                      Jnz GameOver ;Game will end once 30 seconds has gone by
0034: 8097; -- NewRound: CALL GenerateRandomDelay
0035: 9872; --                      Out Sub2 ; Output to 2nd subtimer
0036: 1813; --                      Loadi &B00000010011 ; Reset Sub2, run Sub1 and sub2
0037: 9875; --                      Out SubCmd
0038: 9071; --                      In Sub1
0039: 8082; --                      Call ConvertSeconds
003A: 9805; --                      Out Hex1 ;Displays game clock on left most Hex digits
003B: 9000; --                      In Switches
003C: 38B2; --                      And Player1Mask
003D: 7847; --                      JNZ FalseStart
003E: 9000; --                      In Switches
003F: 38B3; --                      And Player2Mask
0040: 7847; --                      JNZ FalseStart
0041: 9076; --                      In Expiry
0042: 38B1; --                      And Sub2Done ;check if random delay timer for led is up
0043: 7038; --                      Jzero WaitForLed
0044: 1833; --                      Loadi &B00000110011
0045: 9875; --                      Out SubCmd 
0046: 582A; --                      Jump GameLoop
0047: 1801; --                      Loadi 1
0048: 9875; --                      Out SubCmd
0049: 1800; --                      Loadi 0
004A: 9801; --                      Out LEDs
004B: 9000; --                      In Switches
004C: 38B2; --                      And Player1Mask
004D: 784B; --                      JNZ WaitFalseRelease
004E: 9000; --                      In Switches
004F: 38B3; --                      And Player2Mask
0050: 784B; --                      JNZ WaitFalseRelease
0051: 5834; --                      Jump NewRound
0052: 1800; --                      Loadi 0
0053: 9875; --                      Out SubCmd ; stop all subchannels
0054: 9874; --                      Out MasCmd ; stop master 
0055: 9801; --                      Out LEDs ; turn off LEDs
0056: 192C; -- ScoreDisplay: Loadi 300 ; initialize a 3s timer on Sub1 and start.
0057: 9871; --                      Out Sub1
0058: 1839; --                      Loadi &B00000111001 ; reset all subch, run sub1
0059: 9875; --                      Out SubCmd
005A: 1803; --                      Loadi &B00000000011 ; run/reset master
005B: 9874; --                      Out MasCmd
005C: 1801; --                      Loadi 1 ; display p1 score
005D: 9805; --                      Out Hex1
005E: 08A7; --                      Load Score1
005F: 9804; --                      Out Hex0
0060: 807A; --                      Call Wait1
0061: 1808; --                      Loadi 8 ; reset 3s timer for p2 score
0062: 9875; --                      Out SubCmd
0063: 1801; --                      Loadi 1
0064: 9875; --                      Out SubCmd ; start Sub1
0065: 1802; --                      Loadi 2 ; display p2 score
0066: 9805; --                      Out Hex1
0067: 08A8; --                      Load Score2
0068: 9804; --                      Out Hex0
0069: 807A; --                      Call Wait1
006A: 1800; --                      Loadi 0 ; Shows winner on Hex1, 0 on Hex0
006B: 9804; --                      Out Hex0
006C: 08A7; --                      Load Score1 
006D: 28A8; --                      Sub Score2 
006E: 6076; --                      JNeg Win1
006F: 7078; --                      JZero Win0
0070: 1802; --                      Loadi 2 ; p2 win - accumulator = 2
0071: 9805; -- EndScoreDisp: Out Hex1 ; display accumulator on hex1
0072: 1800; --                      Loadi 0
0073: 9874; --                      Out MasCmd
0074: 9875; --                      Out SubCmd
0075: 587E; --                      Jump WaitForRelease
0076: 1801; -- Win1: Loadi 1 ; p1 win - accumulator = 1
0077: 5871; --                      Jump EndScoreDisp
0078: 1800; -- Win0: Loadi 0
0079: 5871; --                      Jump EndScoreDisp ; tie - accumulator = 0
007A: 9076; -- Wait1: In Expiry ; wait until subchannel 1 expires
007B: 20B0; --                      Add Sub1Done
007C: 707A; --                      JZero Wait1
007D: 8800; --                      Return 
007E: 9000; --                      In Switches
007F: 38B6; --                      And StartBit
0080: 787E; --                      JNZ WaitForRelease
0081: 5800; --                      Jump Setup ; clear scores, wait for another start
0082: 10B4; --                      Store TicksRemaining ;store timer value
0083: 1800; --                      Loadi 0
0084: 10B5; --                      Store Seconds ;Start Second count at 0
0085: 08B4; --                      Load TicksRemaining ;Load ticks to convert
0086: 7091; --                      Jzero ConversionDone
0087: 379C; --                      Addi -100 ;Subtract 100 ticks (1 sec)
0088: 608E; --                      JNeg PartialSec ;if negative, less than 1 second remains 
0089: 10B4; --                      Store TicksRemaining
008A: 08B5; --                      Load Seconds 
008B: 3001; --                      Addi 1 ;Increment 'Seconds' count
008C: 10B5; --                      Store Seconds
008D: 5885; --                      Jump ConvertLoop ;repeat process until less than 100 ticks remain
008E: 08B5; --                      Load Seconds
008F: 3001; --                      Addi 1
0090: 8800; --                      Return
0091: 08B5; --                      Load Seconds
0092: 8800; --                      Return
0093: 08AA; --                      Load RNG
0094: 3001; --                      Addi 1
0095: 10AA; --                      Store RNG
0096: 8800; --                      Return
0097: 08AA; --                      Load RNG
0098: 38AB; --                      And Mask3 ; keep two low bits
0099: 70A0; --                      Jzero Delay1 ; 00
009A: 37FF; --                      Addi -1
009B: 70A2; --                      Jzero Delay2 ; 01
009C: 37FF; --                      Addi -1
009D: 70A4; --                      Jzero Delay3 ; 10
009E: 08AD; --                      Load Delay2s ; 11
009F: 58A5; --                      Jump DelayDone
00A0: 08AC; -- Delay1: Load Delay1s
00A1: 58A5; --                      Jump DelayDone
00A2: 08AD; -- Delay2: Load Delay2s
00A3: 58A5; --                      Jump DelayDone
00A4: 08AE; -- Delay3: Load Delay3s
00A5: 10AF; -- DelayDone: Store DelayTicks
00A6: 8800; --                      Return
00A7: 0000; -- Score1: DW 0
00A8: 0000; -- Score2: DW 0
00A9: 012C; -- BaseGain: DW 300
00AA: 0000; -- RNG: DW 0
00AB: 0003; -- Mask3: DW 3
00AC: 0064; -- Delay1s: DW 100 
00AD: 00C8; -- Delay2s: DW 200
00AE: 012C; -- Delay3s: DW 300
00AF: 0000; -- DelayTicks: DW 0
00B0: 0001; -- Sub1Done: DW 1 ; Sub1 expiry flah
00B1: 0002; -- Sub2Done: DW 2 ; Sub2 expiry flah
00B2: 0040; -- Player1Mask: DW 64 ; SW6
00B3: 0001; -- Player2Mask: DW 1 ; SW0
