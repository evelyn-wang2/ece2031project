-- Altera Memory Initialization File (MIF)

DEPTH = 2048;
WIDTH = 16;

ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
  BEGIN
    000 : 1800; -- Loadi 0
    001 : 9804; -- Out Hex0 ;clear player scores
    002 : 9805; -- Out Hex1 ;clear game clock
    003 : 9801; -- Out LEDs ;turn off LEDs
    004 : 9874; -- Out MasCmd ;Stop master channel
    005 : 9875; -- Out SubCmd ;Stop all subchannels
    006 : 1102; -- Store Score1
    007 : 1103; -- Store Score2
    008 : 180a; -- Loadi 10
    009 : 9870; -- Out Master ;sets master tick to 10 ms
    00a : 80ee; -- WaitForStart:        CALL IncrementRNG
    00b : 9000; -- In Switches
    00c : 2917; -- Sub StartBit
    00d : 780a; -- JNZ WaitForStart ;wait until only switch 9 is up for game to begin
    00e : 1802; -- Loadi 2 ;
    00f : 9874; -- Out MasCmd ; resets master + sub-channel counts
    010 : 192c; -- Loadi 300
    011 : 9871; -- Out Sub1 ;Set Sub1 countdown to 3 seconds (10 ms tick * 300 = 3 seconds)
    012 : 1803; -- Loadi 3
    013 : 9805; -- Out Hex1 ;Show 3 on game clock
    014 : 1801; -- Loadi 1
    015 : 9875; -- Out SubCmd ;enables Sub1 to run, but waits for master
    016 : 9874; -- Out MasCmd ;Start master and Sub1 at the same time
    017 : 9071; -- In Sub1
    018 : 80dd; -- Call ConvertSeconds
    019 : 9805; -- Out Hex1 ;Display countdown in seconds on left-most hex
    01a : 9076; -- In Expiry
    01b : 3910; -- And Sub1Done
    01c : 781e; -- Jnz CountDone ;Once countdown is finished, jump to 'CountDone'
    01d : 5817; -- Jump CountDown ;Otherwise repeat
    01e : 1800; -- Loadi 0
    01f : 9875; -- Out SubCmd ;put Sub1 in stop state
    020 : 9805; -- Out Hex1 ;diplay 0 on game clock
    021 : 1802; -- Loadi 2
    022 : 9874; -- Out MasCmd ;resets master + sub-channel counts
    023 : 5824; -- Jump StartGame
    024 : 0918; -- Load GameDuration ;Set Sub1 countdown to 30 seconds (10 ms tick * 3000 = 30 seconds)
    025 : 9871; -- Out Sub1
    026 : 1801; -- Loadi 1
    027 : 9875; -- Out SubCmd ;enables Sub1 to run, but waits for master
    028 : 9874; -- Out MasCmd ;Start master and Sub1 at the same time
    029 : 582a; -- Jump NewRound
    02a : 1811; -- Loadi &B00000010001     ; reset Sub2
    02b : 9875; -- Out SubCmd
    02c : 80f2; -- CALL GenerateRandomDelay
    02d : 9872; -- Out Sub2 ; Output to 2nd subtimer
    02e : 1803; -- Loadi &B00000000011 ; run Sub1 and sub2
    02f : 9875; -- Out SubCmd
    030 : 80ee; -- WaitForLed:          Call IncrementRNG
    031 : 80c8; -- Call ClockCheck ;if game is over, ac won't equal zero
    032 : 787c; -- Jnz GameOver
    033 : 9000; -- In Switches        ; read player switches; if either is high, jump to falsestart
    034 : 3914; -- And BothMask
    035 : 7872; -- JNZ FalseStart
    036 : 9076; -- In Expiry
    037 : 3911; -- And Sub2Done
    038 : 7030; -- Jzero WaitForLed
    039 : 1820; -- Loadi &B0000100000  ;led5  used for gameplay
    03a : 9801; -- Out LEDs
    03b : 1800; -- Loadi 0
    03c : 1107; -- Store Done1 ;reset to zero for each round
    03d : 1108; -- Store Done2
    03e : 1105; -- Store Time1 ;reset to zero for each round
    03f : 1106; -- Store Time2
    040 : 1800; -- Loadi 0    ; revert Sub2 to stopwatch
    041 : 9872; -- Out Sub2
    042 : 1831; -- Loadi &B00000110001
    043 : 9875; -- Out SubCmd
    044 : 1807; -- Loadi &B00000000111 ;run sub1,sub2,sub3
    045 : 9875; -- Out SubCmd
    046 : 80ee; -- Round:               Call IncrementRNG
    047 : 80c8; -- Call ClockCheck ;Check to make sure game clock hasn't expired
    048 : 787c; -- JNZ GameOver
    049 : 0907; -- Load Done1     ; check if p1 is done, jump to p2 check (P1Done) if so
    04a : 7853; -- Jnz P1Done
    04b : 9072; -- In Sub2
    04c : 80b4; -- Call Stop255   ; check to see if they exceeded max value
    04d : 1105; -- Store Time1
    04e : 9000; -- In Switches        ; check if switch is up yet
    04f : 3912; -- And Player1Mask
    050 : 7053; -- Jzero P1Done       ; if switch not up yet, check p2
    051 : 1801; -- Loadi 1 ;if player 1 raises switch, set Done1 to 1
    052 : 1107; -- Store Done1
    053 : 0908; -- Load Done2    ; check if p2 is done, jump to round check (CheckRound) if so
    054 : 785d; -- Jnz CheckRound
    055 : 9073; -- In Sub3
    056 : 80b4; -- Call Stop255   ; check to see if they exceeded max value
    057 : 1106; -- Store Time2
    058 : 9000; -- In Switches    ; check if switch is up yet
    059 : 3913; -- And Player2Mask
    05a : 705d; -- Jzero CheckRound   ; if not up yet, skip Done2
    05b : 1801; -- Loadi 1 ;if player 2 raises switch, set Done2 to 1
    05c : 1108; -- Store Done2
    05d : 80af; -- CheckRound:          Call ShowPlayersTime ; shows/updates times on hex
    05e : 0907; -- Load Done1
    05f : 3908; -- And Done2
    060 : 7046; -- Jzero Round ;check if both have raised sw, otherwise loop
    061 : 1800; -- Loadi 0
    062 : 9801; -- Out LEDs ;Turn off Led
    063 : 0902; -- Load Score1
    064 : 2105; -- Add Time1
    065 : 1102; -- Store Score1
    066 : 0903; -- Load Score2
    067 : 2106; -- Add Time2
    068 : 1103; -- Store Score2
    069 : 1800; -- Loadi 0
    06a : 9874; -- Out MasCmd   ;pause game clock
    06b : 80ee; -- WaitForNRound:      Call IncrementRNG
    06c : 9000; -- In Switches         ; wait for both switches to go down
    06d : 3914; -- And BothMask
    06e : 786b; -- JNZ WaitForNRound
    06f : 1801; -- Loadi 1
    070 : 9874; -- Out MasCmd   ;resume game clock
    071 : 582a; -- Jump NewRound
    072 : 1801; -- Loadi 1
    073 : 9875; -- Out SubCmd ;keep game clock running, stop p1 and p2 clock
    074 : 1800; -- Loadi 0
    075 : 9801; -- Out LEDs
    076 : 58bb; -- Jump PenaltyCheckP1    ; checks which player had false start
    077 : 80ee; -- WaitFalseRelease:    Call IncrementRNG
    078 : 9000; -- In Switches    ; wait for both switches to go back down, then start new round
    079 : 3914; -- And BothMask
    07a : 7877; -- JNZ WaitFalseRelease
    07b : 582a; -- Jump NewRound
    07c : 1800; -- GameOver:            Loadi 0
    07d : 9875; -- Out SubCmd ; stop all subchannels
    07e : 9874; -- Out MasCmd ; stop master
    07f : 9801; -- Out LEDs ; turn off LEDs
    080 : 1802; -- ScoreDisplay:        Loadi 2 ;reset master and subchannels
    081 : 9874; -- Out MasCmd
    082 : 192c; -- Loadi 300 ; initialize a 3s timer on Sub1 and start. (after reset)
    083 : 9871; -- Out Sub1
    084 : 1801; -- Loadi 1 ; run sub1
    085 : 9875; -- Out SubCmd
    086 : 9874; -- Out MasCmd
    087 : 1801; -- Loadi 1 ; display p1 score
    088 : 9805; -- Out Hex1
    089 : 0902; -- Load Score1
    08a : 9804; -- Out Hex0
    08b : 80a7; -- Call Wait1
    08c : 1808; -- Loadi 8 ; reset 3s timer for p2 score
    08d : 9875; -- Out SubCmd
    08e : 192c; -- Loadi 300
    08f : 9871; -- Out Sub1
    090 : 1801; -- Loadi 1
    091 : 9875; -- Out SubCmd ; start Sub1
    092 : 1802; -- Loadi 2 ; display p2 score
    093 : 9805; -- Out Hex1
    094 : 0903; -- Load Score2
    095 : 9804; -- Out Hex0
    096 : 80a7; -- Call Wait1
    097 : 1800; -- Loadi 0 ; Shows winner on Hex1, 0 on Hex0
    098 : 9804; -- Out Hex0
    099 : 0902; -- Load Score1
    09a : 2903; -- Sub Score2
    09b : 60a3; -- JNeg Win1
    09c : 70a5; -- JZero Win0
    09d : 1802; -- Loadi 2 ; p2 win - accumulator = 2
    09e : 9805; -- EndScoreDisp:        Out Hex1 ; display accumulator on hex1
    09f : 1800; -- Loadi 0
    0a0 : 9874; -- Out MasCmd
    0a1 : 9875; -- Out SubCmd
    0a2 : 58ab; -- Jump WaitForRelease
    0a3 : 1801; -- Win1:               Loadi 1 ; p1 win - accumulator = 1
    0a4 : 589e; -- Jump EndScoreDisp
    0a5 : 1800; -- Win0:               Loadi 0
    0a6 : 589e; -- Jump EndScoreDisp ; tie - accumulator = 0
    0a7 : 9076; -- Wait1:               In Expiry ; wait until subchannel 1 expires
    0a8 : 3910; -- And Sub1Done
    0a9 : 70a7; -- JZero Wait1
    0aa : 8800; -- Return
    0ab : 9000; -- In Switches
    0ac : 3917; -- And StartBit
    0ad : 78ab; -- JNZ WaitForRelease
    0ae : 5800; -- Jump Setup ; clear scores, wait for another start
    0af : 0905; -- Load Time1
    0b0 : 5008; -- Shift 8     ; player 1 in upper two digits
    0b1 : 2106; -- Add Time2      ; player 2 in lower two digits
    0b2 : 9804; -- Out Hex0
    0b3 : 8800; -- Return
    0b4 : 1109; -- Store StopTmp
    0b5 : 3701; -- Addi -255
    0b6 : 68b9; -- JPos Above255
    0b7 : 0909; -- Load StopTmp
    0b8 : 8800; -- Return
    0b9 : 18ff; -- Above255:             Loadi 255
    0ba : 8800; -- Return
    0bb : 9000; -- In Switches
    0bc : 3912; -- And Player1Mask
    0bd : 70c1; -- Jzero PenaltyCheckP2 ; checks p2 if p1 is not the false start
    0be : 0902; -- Load Score1
    0bf : 312c; -- Addi 300 ;if player 1 false started, add 300 to score
    0c0 : 1102; -- Store Score1
    0c1 : 9000; -- PenaltyCheckP2:      In Switches
    0c2 : 3913; -- And Player2Mask
    0c3 : 7077; -- Jzero WaitFalseRelease
    0c4 : 0903; -- Load Score2
    0c5 : 312c; -- Addi 300 ;if player 2 false started, add 300 to score
    0c6 : 1103; -- Store Score2
    0c7 : 5877; -- Jump WaitFalseRelease
    0c8 : 80cf; -- Call PauseCheck
    0c9 : 9071; -- In Sub1
    0ca : 80dd; -- Call ConvertSeconds
    0cb : 9805; -- Out Hex1 ;Displays game clock on left most Hex digits
    0cc : 9076; -- In Expiry
    0cd : 3910; -- And Sub1Done
    0ce : 8800; -- Return
    0cf : 9000; -- In Switches
    0d0 : 3917; -- And StartBit
    0d1 : 78da; -- Jnz Running ;if sw9 is up, that means its running
    0d2 : 58d3; -- Jump Pause
    0d3 : 1800; -- Loadi 0
    0d4 : 9874; -- Out MasCmd ;pause master, which pauses all channels
    0d5 : 80ee; -- Call IncrementRNG
    0d6 : 9000; -- In Switches
    0d7 : 3917; -- And StartBit
    0d8 : 70d3; -- Jzero Pause ;if equal to zero -> SW9 is down, so repeat loop
    0d9 : 58da; -- Jump Running ; if sw9 is up, resume game
    0da : 1801; -- Loadi 1
    0db : 9874; -- Out MasCmd
    0dc : 8800; -- Return
    0dd : 1115; -- Store TicksRemaining ;store timer value
    0de : 1800; -- Loadi 0
    0df : 1116; -- Store Seconds ;Start Second count at 0
    0e0 : 0915; -- Load TicksRemaining ;Load ticks to convert
    0e1 : 70ec; -- Jzero ConversionDone
    0e2 : 379c; -- Addi -100 ;Subtract 100 ticks (1 sec)
    0e3 : 60e9; -- JNeg PartialSec ;if negative, less than 1 second remains
    0e4 : 1115; -- Store TicksRemaining
    0e5 : 0916; -- Load Seconds
    0e6 : 3001; -- Addi 1 ;Increment 'Seconds' count
    0e7 : 1116; -- Store Seconds
    0e8 : 58e0; -- Jump ConvertLoop ;repeat process until less than 100 ticks remain
    0e9 : 0916; -- Load Seconds
    0ea : 3001; -- Addi 1
    0eb : 8800; -- Return
    0ec : 0916; -- Load Seconds
    0ed : 8800; -- Return
    0ee : 090a; -- Load RNG
    0ef : 3001; -- Addi 1
    0f0 : 110a; -- Store RNG
    0f1 : 8800; -- Return
    0f2 : 090a; -- Load RNG
    0f3 : 390b; -- And Mask3 ; keep two low bits
    0f4 : 70fb; -- Jzero Delay1 ; 00
    0f5 : 37ff; -- Addi -1
    0f6 : 70fd; -- Jzero Delay2 ; 01
    0f7 : 37ff; -- Addi -1
    0f8 : 70ff; -- Jzero Delay3 ; 10
    0f9 : 090d; -- Load Delay2s ; 11
    0fa : 5900; -- Jump DelayDone
    0fb : 090c; -- Delay1: Load Delay1s
    0fc : 5900; -- Jump DelayDone
    0fd : 090d; -- Delay2: Load Delay2s
    0fe : 5900; -- Jump DelayDone
    0ff : 090e; -- Delay3: Load Delay3s
    100 : 110f; -- DelayDone: Store DelayTicks
    101 : 8800; -- Return
    102 : 0000; -- Score1: DW 0
    103 : 0000; -- Score2: DW 0
    104 : 012c; -- BaseGain: DW 300
    105 : 0000; -- Time1:     DW 0
    106 : 0000; -- Time2:     DW 0
    107 : 0000; -- Done1:  DW 0
    108 : 0000; -- Done2:  DW 0
    109 : 0000; -- StopTmp: DW 0
    10a : 0000; -- RNG: DW 0
    10b : 0003; -- Mask3: DW 3
    10c : 0064; -- Delay1s: DW 100
    10d : 00c8; -- Delay2s: DW 200
    10e : 012c; -- Delay3s: DW 300
    10f : 0000; -- DelayTicks: DW 0
    110 : 0001; -- Sub1Done: DW 1 ; Sub1 expiry flah
    111 : 0002; -- Sub2Done: DW 2 ; Sub2 expiry flah
    112 : 0040; -- Player1Mask: DW 64 ; SW6
    113 : 0001; -- Player2Mask: DW 1 ; SW0
    114 : 0041; -- BothMask:    DW 65 ; SW6 + SW0
    115 : 0000; -- TicksRemaining: DW 0
    116 : 0000; -- Seconds: DW 0
    117 : 0200; -- StartBit: DW &B1000000000
    118 : 0bb8; -- GameDuration: DW 3000

    [119..7ff] : 0000; -- Empty memory

  END;
