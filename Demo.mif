-- Altera Memory Initialization File (MIF)

DEPTH = 2048;
WIDTH = 16;

ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
  BEGIN
    000 : 1800; -- Loadi 0
    001 : 9804; -- Out Hex0 ;clear player scores
    002 : 9805; -- Out Hex1 ;clear game clock
    003 : 9801; -- Out LEDs ;turn off LEDs
    004 : 9874; -- Out MasCmd ;Stop master channel
    005 : 9875; -- Out SubCmd ;Stop all subchannels
    006 : 108b; -- Store Score1
    007 : 108c; -- Store Score2
    008 : 180a; -- Loadi 10
    009 : 9870; -- Out Master ;sets master tick to 10 ms
    00a : 8077; -- WaitForStart:   CALL IncrementRNG
    00b : 9000; -- In Switches
    00c : 2897; -- Sub StartBit
    00d : 780a; -- JNZ WaitForStart ;wait until only switch 9 is up for game to begin
    00e : 1802; -- Loadi 2 ;
    00f : 9874; -- Out MasCmd ; resets master + sub-channel counts
    010 : 192c; -- Loadi 300
    011 : 9871; -- Out Sub1 ;Set Sub1 countdown to 3 seconds (10 ms tick * 300 = 3 seconds)
    012 : 1803; -- Loadi 3
    013 : 9805; -- Out Hex1 ;Show 3 on game clock
    014 : 1801; -- Loadi 1
    015 : 9875; -- Out SubCmd ;enables Sub1 to run, but waits for master
    016 : 9874; -- Out MasCmd ;Start master and Sub1 at the same time
    017 : 9071; -- In Sub1
    018 : 8066; -- Call ConvertSeconds
    019 : 9805; -- Out Hex1 ;Display countdown in seconds on left-most hex
    01a : 9076; -- In Expiry
    01b : 3894; -- And Sub1Done
    01c : 781e; -- Jnz CountDone ;Once countdown is finished, jump to 'CountDone'
    01d : 5817; -- Jump CountDown ;Otherwise repeat
    01e : 1800; -- Loadi 0
    01f : 9875; -- Out SubCmd ;put Sub1 in stop state
    020 : 9805; -- Out Hex1 ;diplay 0 on game clock
    021 : 1802; -- Loadi 2
    022 : 9874; -- Out MasCmd ;resets master + sub-channel counts
    023 : 5824; -- Jump StartGame
    024 : 0898; -- Load GameDuration ;Set Sub1 countdown to 30 seconds (10 ms tick * 3000 = 3 seconds)
    025 : 9871; -- Out Sub1
    026 : 1801; -- Loadi 1
    027 : 9875; -- Out SubCmd ;enables Sub1 to run, but waits for master
    028 : 9874; -- Out MasCmd ;Start master and Sub1 at the same time
    029 : 582a; -- Jump NewRound
    02a : 807b; -- NewRound:       CALL GenerateRandomDelay
    02b : 9872; -- Out Sub2                ; Output to 2nd subtimer
    02c : 1813; -- Loadi &B00000010011     ; Reset Sub2, run Sub1 and sub2
    02d : 9875; -- Out SubCmd
    02e : 9000; -- GameLoop:       In Switches ; pause mechanism
    02f : 3897; -- And StartBit
    030 : 5019; -- Shift -9
    031 : 9874; -- Out MasCmd
    032 : 9071; -- In Sub1
    033 : 8066; -- Call ConvertSeconds
    034 : 9805; -- Out Hex1 ;Displays game clock on left most Hex digits
    035 : 9076; -- In Expiry
    036 : 3894; -- And Sub1Done
    037 : 7839; -- Jnz GameOver ;Game will end once 30 seconds has gone by
    038 : 582e; -- Jump GameLoop
    039 : 1800; -- Loadi 0
    03a : 9875; -- Out SubCmd ; stop all subchannels
    03b : 9874; -- Out MasCmd ; stop master
    03c : 9801; -- Out LEDs ; turn off LEDs
    03d : 192c; -- ScoreDisplay:   Loadi 300   ; initialize a 3s timer on Sub1 and start.
    03e : 9871; -- Out Sub1
    03f : 1839; -- Loadi &B00000111001 ; reset all subch, run sub1
    040 : 9875; -- Out SubCmd
    041 : 1803; -- Loadi &B00000000011 ; run/reset master
    042 : 9874; -- Out MasCmd
    043 : 1801; -- Loadi 1     ; display p1 score
    044 : 9805; -- Out Hex1
    045 : 088b; -- Load Score1
    046 : 9804; -- Out Hex0
    047 : 805e; -- Call Wait1
    048 : 183c; -- Loadi &B00000111100 ; reset 3s timer for p2 score
    049 : 9875; -- Out SubCmd
    04a : 1802; -- Loadi 2     ; display p2 score
    04b : 9805; -- Out Hex1
    04c : 088c; -- Load Score2
    04d : 9804; -- Out Hex0
    04e : 1839; -- Loadi &B00000111001 ; reset all subch, run sub1
    04f : 9875; -- Out SubCmd
    050 : 805e; -- Call Wait1
    051 : 1800; -- Loadi 0             ; Shows winner on Hex1, 0 on Hex0
    052 : 9804; -- Out Hex0
    053 : 088b; -- Load Score1
    054 : 288c; -- Sub Score2
    055 : 605a; -- JNeg Win1
    056 : 705c; -- JZero Win0
    057 : 1802; -- Loadi 2             ; p2 win - accumulator = 2
    058 : 9805; -- EndScoreDisp:   Out Hex1            ; display accumulator on hex1
    059 : 5862; -- Jump WaitForRelease
    05a : 1801; -- Win1:           Loadi 1             ; p1 win - accumulator = 1
    05b : 5858; -- Jump EndScoreDisp
    05c : 1800; -- Win0:           Loadi 0
    05d : 5858; -- Jump EndScoreDisp   ; tie - accumulator = 0
    05e : 9076; -- Wait1:          In Expiry ; wait until subchannel 1 expires
    05f : 37ff; -- Addi -1
    060 : 785e; -- JNZ Wait1
    061 : 8800; -- Return
    062 : 9000; -- In Switches
    063 : 3897; -- And StartBit
    064 : 7862; -- JNZ WaitForRelease
    065 : 5800; -- Jump Setup ; clear scores, wait for another start
    066 : 1095; -- Store TicksRemaining ;store timer value
    067 : 1800; -- Loadi 0
    068 : 1096; -- Store Seconds ;Start Second count at 0
    069 : 0895; -- Load TicksRemaining ;Load ticks to convert
    06a : 7075; -- Jzero ConversionDone
    06b : 379c; -- Addi -100 ;Subtract 100 ticks (1 sec)
    06c : 6072; -- JNeg PartialSec ;if negative, less than 1 second remains
    06d : 1095; -- Store TicksRemaining
    06e : 0896; -- Load Seconds
    06f : 3001; -- Addi 1 ;Increment 'Seconds' count
    070 : 1096; -- Store Seconds
    071 : 5869; -- Jump ConvertLoop ;repeat process until less than 100 ticks remain
    072 : 0896; -- Load Seconds
    073 : 3001; -- Addi 1
    074 : 8800; -- Return
    075 : 0896; -- Load Seconds
    076 : 8800; -- Return
    077 : 088e; -- Load    RNG
    078 : 3001; -- Addi    1
    079 : 108e; -- Store   RNG
    07a : 8800; -- Return
    07b : 088e; -- Load    RNG
    07c : 388f; -- And     Mask3           ; keep two low bits
    07d : 7084; -- Jzero   Delay1         ; 00
    07e : 37ff; -- Addi    -1
    07f : 7086; -- Jzero   Delay2         ; 01
    080 : 37ff; -- Addi    -1
    081 : 7088; -- Jzero   Delay3         ; 10
    082 : 0891; -- Load    Delay2s         ; 11
    083 : 5889; -- Jump    DelayDone
    084 : 0890; -- Delay1:        Load    Delay1s
    085 : 5889; -- Jump    DelayDone
    086 : 0891; -- Delay2:        Load    Delay2s
    087 : 5889; -- Jump    DelayDone
    088 : 0892; -- Delay3:        Load    Delay3s
    089 : 1093; -- DelayDone:      Store   DelayTicks
    08a : 8800; -- Return
    08b : 0000; -- Score1: DW 0
    08c : 0000; -- Score2: DW 0
    08d : 012c; -- BaseGain: DW 300
    08e : 0000; -- RNG:    DW 0
    08f : 0003; -- Mask3:          DW 3
    090 : 0064; -- Delay1s:        DW 100
    091 : 00c8; -- Delay2s:        DW 200
    092 : 012c; -- Delay3s:        DW 300
    093 : 0000; -- DelayTicks:     DW 0
    094 : 0001; -- Sub1Done: DW 1
    095 : 0000; -- TicksRemaining: DW 0
    096 : 0000; -- Seconds: DW 0
    097 : 0200; -- StartBit: DW &B1000000000
    098 : 0bb8; -- GameDuration: DW 3000

    [099..7ff] : 0000; -- Empty memory

  END;
