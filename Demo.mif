-- Altera Memory Initialization File (MIF)

DEPTH = 2048;
WIDTH = 16;

ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;

CONTENT
  BEGIN
    000 : 1800; -- Loadi 0
    001 : 9804; -- Out Hex0 ;clear player scores
    002 : 9805; -- Out Hex1 ;clear game clock
    003 : 9801; -- Out LEDs ;turn off LEDs
    004 : 9874; -- Out MasCmd ;Stop master channel
    005 : 9875; -- Out SubCmd ;Stop all subchannels
    006 : 10ff; -- Store Score1
    007 : 1100; -- Store Score2
    008 : 180a; -- Loadi 10
    009 : 9870; -- Out Master ;sets master tick to 10 ms
    00a : 80eb; -- WaitForStart:        CALL IncrementRNG
    00b : 9000; -- In Switches
    00c : 2914; -- Sub StartBit
    00d : 780a; -- JNZ WaitForStart ;wait until only switch 9 is up for game to begin
    00e : 1802; -- Loadi 2 ;
    00f : 9874; -- Out MasCmd ; resets master + sub-channel counts
    010 : 192c; -- Loadi 300
    011 : 9871; -- Out Sub1 ;Set Sub1 countdown to 3 seconds (10 ms tick * 300 = 3 seconds)
    012 : 1803; -- Loadi 3
    013 : 9805; -- Out Hex1 ;Show 3 on game clock
    014 : 1801; -- Loadi 1
    015 : 9875; -- Out SubCmd ;enables Sub1 to run, but waits for master
    016 : 9874; -- Out MasCmd ;Start master and Sub1 at the same time
    017 : 9071; -- In Sub1
    018 : 80da; -- Call ConvertSeconds
    019 : 9805; -- Out Hex1 ;Display countdown in seconds on left-most hex
    01a : 9076; -- In Expiry
    01b : 390d; -- And Sub1Done
    01c : 781e; -- Jnz CountDone ;Once countdown is finished, jump to 'CountDone'
    01d : 5817; -- Jump CountDown ;Otherwise repeat
    01e : 1800; -- Loadi 0
    01f : 9875; -- Out SubCmd ;put Sub1 in stop state
    020 : 9805; -- Out Hex1 ;diplay 0 on game clock
    021 : 1802; -- Loadi 2
    022 : 9874; -- Out MasCmd ;resets master + sub-channel counts
    023 : 5824; -- Jump StartGame
    024 : 0915; -- Load GameDuration ;Set Sub1 countdown to 30 seconds (10 ms tick * 3000 = 30 seconds)
    025 : 9871; -- Out Sub1
    026 : 1801; -- Loadi 1
    027 : 9875; -- Out SubCmd ;enables Sub1 to run, but waits for master
    028 : 9874; -- Out MasCmd ;Start master and Sub1 at the same time
    029 : 582a; -- Jump NewRound
    02a : 1800; -- NewRound:            Loadi 0
    02b : 9801; -- Out LEDs ;Turn off Led
    02c : 1811; -- Loadi &B00000010001     ; reset Sub2
    02d : 9875; -- Out SubCmd
    02e : 80ef; -- CALL GenerateRandomDelay
    02f : 9872; -- Out Sub2 ; Output to 2nd subtimer
    030 : 1803; -- Loadi &B00000000011 ; run Sub1 and sub2
    031 : 9875; -- Out SubCmd
    032 : 80eb; -- WaitForLed:          Call IncrementRNG
    033 : 80c5; -- Call ClockCheck ;if game is over, ac won't equal zero
    034 : 7875; -- Jnz GameOver
    035 : 9000; -- In Switches        ; read player switches; if either is high, jump to falsestart
    036 : 3911; -- And BothMask
    037 : 7872; -- JNZ FalseStart
    038 : 9076; -- In Expiry
    039 : 390e; -- And Sub2Done
    03a : 7032; -- Jzero WaitForLed
    03b : 1808; -- Loadi &B0000001000  ;led3  used for gameplay
    03c : 9801; -- Out LEDs
    03d : 1800; -- Loadi 0
    03e : 1104; -- Store Done1 ;reset to zero for each round
    03f : 1105; -- Store Done2
    040 : 1102; -- Store Time1 ;reset to zero for each round
    041 : 1103; -- Store Time2
    042 : 1800; -- Loadi 0    ; revert Sub2 to stopwatch
    043 : 9872; -- Out Sub2
    044 : 1831; -- Loadi &B00000110001
    045 : 9875; -- Out SubCmd
    046 : 1807; -- Loadi &B00000000111 ;run sub1,sub2,sub3
    047 : 9875; -- Out SubCmd
    048 : 80eb; -- Round:               Call IncrementRNG
    049 : 80c5; -- Call ClockCheck ;Check to make sure game clock hasn't expired
    04a : 7875; -- JNZ GameOver
    04b : 0904; -- Load Done1     ; check if p1 is done, jump to p2 check (P1Done) if so
    04c : 7855; -- Jnz P1Done
    04d : 9072; -- In Sub2
    04e : 80ad; -- Call Stop255   ; check to see if they exceeded max value
    04f : 1102; -- Store Time1
    050 : 9000; -- In Switches        ; check if switch is up yet
    051 : 390f; -- And Player1Mask
    052 : 7055; -- Jzero P1Done       ; if switch not up yet, check p2
    053 : 1801; -- Loadi 1 ;if player 1 raises switch, set Done1 to 1
    054 : 1104; -- Store Done1
    055 : 0905; -- Load Done2    ; check if p2 is done, jump to round check (CheckRound) if so
    056 : 785f; -- Jnz CheckRound
    057 : 9073; -- In Sub3
    058 : 80ad; -- Call Stop255   ; check to see if they exceeded max value
    059 : 1103; -- Store Time2
    05a : 9000; -- In Switches    ; check if switch is up yet
    05b : 3910; -- And Player2Mask
    05c : 705f; -- Jzero CheckRound   ; if not up yet, skip Done2
    05d : 1801; -- Loadi 1 ;if player 2 raises switch, set Done2 to 1
    05e : 1105; -- Store Done2
    05f : 80a8; -- CheckRound:          Call ShowPlayersTime ; shows/updates times on hex
    060 : 0904; -- Load Done1
    061 : 3905; -- And Done2
    062 : 7048; -- Jzero Round ;check if both have raised sw, otherwise loop
    063 : 08ff; -- Load Score1
    064 : 2102; -- Add Time1
    065 : 10ff; -- Store Score1
    066 : 0900; -- Load Score2
    067 : 2103; -- Add Time2
    068 : 1100; -- Store Score2
    069 : 1800; -- Loadi 0
    06a : 9874; -- Out MasCmd   ;pause game clock
    06b : 80eb; -- WaitForNRound:      Call IncrementRNG
    06c : 9000; -- In Switches         ; wait for both switches to go down
    06d : 3911; -- And BothMask
    06e : 786b; -- JNZ WaitForNRound
    06f : 1801; -- Loadi 1
    070 : 9874; -- Out MasCmd   ;resume game clock
    071 : 582a; -- Jump NewRound
    072 : 1800; -- Loadi 0
    073 : 9874; -- Out MasCmd ;keep game clock running, stop p1 and p2 clock
    074 : 58b4; -- Jump PenaltyCheckP1    ; checks which player had false start
    075 : 1800; -- GameOver:            Loadi 0
    076 : 9875; -- Out SubCmd ; stop all subchannels
    077 : 9874; -- Out MasCmd ; stop master
    078 : 9801; -- Out LEDs ; turn off LEDs
    079 : 1802; -- ScoreDisplay:        Loadi 2 ;reset master and subchannels
    07a : 9874; -- Out MasCmd
    07b : 192c; -- Loadi 300 ; initialize a 3s timer on Sub1 and start. (after reset)
    07c : 9871; -- Out Sub1
    07d : 1801; -- Loadi 1 ; run sub1
    07e : 9875; -- Out SubCmd
    07f : 9874; -- Out MasCmd
    080 : 1801; -- Loadi 1 ; display p1 score
    081 : 9805; -- Out Hex1
    082 : 08ff; -- Load Score1
    083 : 9804; -- Out Hex0
    084 : 80a0; -- Call Wait1
    085 : 1808; -- Loadi 8 ; reset 3s timer for p2 score
    086 : 9875; -- Out SubCmd
    087 : 192c; -- Loadi 300
    088 : 9871; -- Out Sub1
    089 : 1801; -- Loadi 1
    08a : 9875; -- Out SubCmd ; start Sub1
    08b : 1802; -- Loadi 2 ; display p2 score
    08c : 9805; -- Out Hex1
    08d : 0900; -- Load Score2
    08e : 9804; -- Out Hex0
    08f : 80a0; -- Call Wait1
    090 : 1800; -- Loadi 0 ; Shows winner on Hex1, 0 on Hex0
    091 : 9804; -- Out Hex0
    092 : 08ff; -- Load Score1
    093 : 2900; -- Sub Score2
    094 : 609c; -- JNeg Win1
    095 : 709e; -- JZero Win0
    096 : 1802; -- Loadi 2 ; p2 win - accumulator = 2
    097 : 9805; -- EndScoreDisp:        Out Hex1 ; display accumulator on hex1
    098 : 1800; -- Loadi 0
    099 : 9874; -- Out MasCmd
    09a : 9875; -- Out SubCmd
    09b : 58a4; -- Jump WaitForRelease
    09c : 1801; -- Win1:               Loadi 1 ; p1 win - accumulator = 1
    09d : 5897; -- Jump EndScoreDisp
    09e : 1800; -- Win0:               Loadi 0
    09f : 5897; -- Jump EndScoreDisp ; tie - accumulator = 0
    0a0 : 9076; -- Wait1:               In Expiry ; wait until subchannel 1 expires
    0a1 : 390d; -- And Sub1Done
    0a2 : 70a0; -- JZero Wait1
    0a3 : 8800; -- Return
    0a4 : 9000; -- In Switches
    0a5 : 3914; -- And StartBit
    0a6 : 78a4; -- JNZ WaitForRelease
    0a7 : 5800; -- Jump Setup ; clear scores, wait for another start
    0a8 : 0902; -- Load Time1
    0a9 : 5008; -- Shift 8     ; player 1 in upper two digits
    0aa : 2103; -- Add Time2      ; player 2 in lower two digits
    0ab : 9804; -- Out Hex0
    0ac : 8800; -- Return
    0ad : 1106; -- Store StopTmp
    0ae : 3701; -- Addi -255
    0af : 68b2; -- JPos Above255
    0b0 : 0906; -- Load StopTmp
    0b1 : 8800; -- Return
    0b2 : 18ff; -- Above255:             Loadi 255
    0b3 : 8800; -- Return
    0b4 : 9000; -- In Switches
    0b5 : 390f; -- And Player1Mask
    0b6 : 70bc; -- Jzero PenaltyCheckP2 ; checks p2 if p1 is not the false start
    0b7 : 08ff; -- Load Score1
    0b8 : 312c; -- Addi 300 ;if player 1 false started, add 300 to score
    0b9 : 10ff; -- Store Score1
    0ba : 090f; -- Load Player1Mask
    0bb : 9801; -- Out LEDs
    0bc : 9000; -- PenaltyCheckP2:      In Switches
    0bd : 3910; -- And Player2Mask
    0be : 706b; -- Jzero WaitForNRound
    0bf : 0900; -- Load Score2
    0c0 : 312c; -- Addi 300 ;if player 2 false started, add 300 to score
    0c1 : 1100; -- Store Score2
    0c2 : 0910; -- Load Player2Mask
    0c3 : 9801; -- Out LEDs
    0c4 : 586b; -- Jump WaitForNRound
    0c5 : 80cc; -- Call PauseCheck
    0c6 : 9071; -- In Sub1
    0c7 : 80da; -- Call ConvertSeconds
    0c8 : 9805; -- Out Hex1 ;Displays game clock on left most Hex digits
    0c9 : 9076; -- In Expiry
    0ca : 390d; -- And Sub1Done
    0cb : 8800; -- Return
    0cc : 9000; -- In Switches
    0cd : 3914; -- And StartBit
    0ce : 78d7; -- Jnz Running ;if sw9 is up, that means its running
    0cf : 58d0; -- Jump Pause
    0d0 : 1800; -- Loadi 0
    0d1 : 9874; -- Out MasCmd ;pause master, which pauses all channels
    0d2 : 80eb; -- Call IncrementRNG
    0d3 : 9000; -- In Switches
    0d4 : 3914; -- And StartBit
    0d5 : 70d0; -- Jzero Pause ;if equal to zero -> SW9 is down, so repeat loop
    0d6 : 58d7; -- Jump Running ; if sw9 is up, resume game
    0d7 : 1801; -- Loadi 1
    0d8 : 9874; -- Out MasCmd
    0d9 : 8800; -- Return
    0da : 1112; -- Store TicksRemaining ;store timer value
    0db : 1800; -- Loadi 0
    0dc : 1113; -- Store Seconds ;Start Second count at 0
    0dd : 0912; -- Load TicksRemaining ;Load ticks to convert
    0de : 70e9; -- Jzero ConversionDone
    0df : 379c; -- Addi -100 ;Subtract 100 ticks (1 sec)
    0e0 : 60e6; -- JNeg PartialSec ;if negative, less than 1 second remains
    0e1 : 1112; -- Store TicksRemaining
    0e2 : 0913; -- Load Seconds
    0e3 : 3001; -- Addi 1 ;Increment 'Seconds' count
    0e4 : 1113; -- Store Seconds
    0e5 : 58dd; -- Jump ConvertLoop ;repeat process until less than 100 ticks remain
    0e6 : 0913; -- Load Seconds
    0e7 : 3001; -- Addi 1
    0e8 : 8800; -- Return
    0e9 : 0913; -- Load Seconds
    0ea : 8800; -- Return
    0eb : 0907; -- Load RNG
    0ec : 3001; -- Addi 1
    0ed : 1107; -- Store RNG
    0ee : 8800; -- Return
    0ef : 0907; -- Load RNG
    0f0 : 3908; -- And Mask3 ; keep two low bits
    0f1 : 70f8; -- Jzero Delay1 ; 00
    0f2 : 37ff; -- Addi -1
    0f3 : 70fa; -- Jzero Delay2 ; 01
    0f4 : 37ff; -- Addi -1
    0f5 : 70fc; -- Jzero Delay3 ; 10
    0f6 : 090a; -- Load Delay2s ; 11
    0f7 : 58fd; -- Jump DelayDone
    0f8 : 0909; -- Delay1: Load Delay1s
    0f9 : 58fd; -- Jump DelayDone
    0fa : 090a; -- Delay2: Load Delay2s
    0fb : 58fd; -- Jump DelayDone
    0fc : 090b; -- Delay3: Load Delay3s
    0fd : 110c; -- DelayDone: Store DelayTicks
    0fe : 8800; -- Return
    0ff : 0000; -- Score1: DW 0
    100 : 0000; -- Score2: DW 0
    101 : 012c; -- BaseGain: DW 300
    102 : 0000; -- Time1:     DW 0
    103 : 0000; -- Time2:     DW 0
    104 : 0000; -- Done1:  DW 0
    105 : 0000; -- Done2:  DW 0
    106 : 0000; -- StopTmp: DW 0
    107 : 0000; -- RNG: DW 0
    108 : 0003; -- Mask3: DW 3
    109 : 0064; -- Delay1s: DW 100
    10a : 00c8; -- Delay2s: DW 200
    10b : 012c; -- Delay3s: DW 300
    10c : 0000; -- DelayTicks: DW 0
    10d : 0001; -- Sub1Done: DW 1 ; Sub1 expiry flah
    10e : 0002; -- Sub2Done: DW 2 ; Sub2 expiry flah
    10f : 0040; -- Player1Mask: DW 64 ; SW6
    110 : 0001; -- Player2Mask: DW 1 ; SW0
    111 : 0041; -- BothMask:    DW 65 ; SW6 + SW0
    112 : 0000; -- TicksRemaining: DW 0
    113 : 0000; -- Seconds: DW 0
    114 : 0200; -- StartBit: DW &B1000000000
    115 : 0bb8; -- GameDuration: DW 3000

    [116..7ff] : 0000; -- Empty memory

  END;
