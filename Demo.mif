WIDTH=16;
DEPTH=2048;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN
0000: 1800; --                      Loadi 0
0001: 9804; --                      Out Hex0 ;clear player scores
0002: 9805; --                      Out Hex1 ;clear game clock
0003: 9801; --                      Out LEDs ;turn off LEDs
0004: 9874; --                      Out MasCmd ;Stop master channel
0005: 9875; --                      Out SubCmd ;Stop all subchannels
0006: 10A7; --                      Store Score1 
